# Server Configuration
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/authforge?schema=public"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets & Expiry
JWT_ACCESS_SECRET=authforge_super_secret_access_key_change_in_production_32bytes
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=authforge_super_secret_refresh_key_change_in_production_32bytes
JWT_REFRESH_EXPIRATION=7d

# Rate Limiting
RATE_LIMIT_LOGIN_MAX=50
RATE_LIMIT_LOGIN_WINDOW_SEC=60
RATE_LIMIT_API_MAX=100
RATE_LIMIT_API_WINDOW_SEC=60

# OAuth Credentials (Google & GitHub)
GOOGLE_CLIENT_ID=mock-google-client-id
GOOGLE_CLIENT_SECRET=mock-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/google/callback

GITHUB_CLIENT_ID=mock-github-client-id
GITHUB_CLIENT_SECRET=mock-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/oauth/github/callback

# CORS Settings
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
